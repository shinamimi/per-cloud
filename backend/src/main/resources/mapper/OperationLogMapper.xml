<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cloud.backend.mapper.OperationLogMapper">

    <!-- operation / target_type 为枚举类型，MyBatis 默认的 EnumTypeHandler 存储 name() -->
    <insert id="insert" parameterType="com.cloud.backend.entity.OperationLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_operation_log (user_id, operation, target_type, target_id, detail, ip, user_agent)
        VALUES (#{userId}, #{operation}, #{targetType}, #{targetId}, #{detail}, #{ip}, #{userAgent})
    </insert>

    <select id="findByUserId" resultType="com.cloud.backend.entity.OperationLog">
        SELECT * FROM t_operation_log WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <select id="findAll" resultType="com.cloud.backend.entity.OperationLog">
        SELECT * FROM t_operation_log ORDER BY created_at DESC
    </select>

    <select id="findByFilter" parameterType="com.cloud.backend.dto.admin.LogFilterRequest"
            resultType="com.cloud.backend.entity.OperationLog">
        SELECT * FROM t_operation_log
        <where>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="operation != null">AND operation = #{operation}</if>
            <if test="targetType != null">AND target_type = #{targetType}</if>
            <if test="startTime != null">AND created_at &gt;= #{startTime}</if>
            <if test="endTime != null">AND created_at &lt;= #{endTime}</if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!--
      按创建时间批量删除。
      operation：具体类型（如 LOGIN）；"NON_LOGIN" = 排除 LOGIN 的所有类型；null/空 = 全部类型。
    -->
    <delete id="deleteByCreatedAtBefore">
        DELETE FROM t_operation_log
        WHERE created_at &lt; #{cutoff}
        <choose>
            <when test="operation == 'NON_LOGIN'">AND operation != 'LOGIN'</when>
            <when test="operation != null and operation != ''">AND operation = #{operation}</when>
        </choose>
    </delete>

    <!-- 分页查询条件（findPaged / countByFilter 共用） -->
    <sql id="filterWhere">
        <where>
            <if test="filter.userId != null">AND l.user_id = #{filter.userId}</if>
            <if test="filter.operation != null">AND l.operation = #{filter.operation}</if>
            <if test="filter.targetType != null">AND l.target_type = #{filter.targetType}</if>
            <if test="filter.startTime != null">AND l.created_at &gt;= #{filter.startTime}</if>
            <if test="filter.endTime != null">AND l.created_at &lt;= #{filter.endTime}</if>
        </where>
    </sql>

    <!-- 管理端分页查询：join 用户表带出用户名（登录日志可复用，传 operation=LOGIN） -->
    <select id="findPaged" resultType="com.cloud.backend.dto.admin.LogItem">
        SELECT l.id, l.user_id, u.username, l.operation, l.detail, l.ip, l.created_at
        FROM t_operation_log l
        LEFT JOIN t_user u ON u.id = l.user_id
        <include refid="filterWhere"/>
        ORDER BY l.created_at DESC
        LIMIT #{page.offset}, #{page.size}
    </select>

    <select id="countByFilter" resultType="long">
        SELECT COUNT(*)
        FROM t_operation_log l
        <include refid="filterWhere"/>
    </select>

</mapper>